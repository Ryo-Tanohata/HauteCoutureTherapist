# ---------------------------------------------------------------------------
# 星詠みメッセージの生成AI
# ---------------------------------------------------------------------------
# 何も設定しなければ Claude を優先し、失敗したら Gemini にフォールバックする。
#
# Claude の認証は2経路ある。アプリ側にログイン画面は出ない。
#   1) 何も設定しない                … 事前に `claude` でログインしたこのPCの
#                                      claude.ai プラン枠を使う。開発と、自分
#                                      ひとりで使う運用はこれでOK。APIキー不要。
#   2) ANTHROPIC_API_KEY を設定する  … 他の人にも使わせる場合（共有・配布・本番）。
#
# ⚠️ 判断基準は「自分以外の人のリクエストがそこを通るか」。
#    事前承認がない限り、claude.ai のログイン／レート枠を自分のプロダクトに
#    使うことは認められていない（Agent SDK のドキュメント記載）。
#    自分の作業に使う分はこれに当たらない。

# 使うAIを1つに固定したい時だけ設定する（claude / anthropic / gemini）。
# 指定するとフォールバックしない。切り分け・デバッグ用。
# AI_PROVIDER=claude

# Claude のモデル。未設定なら claude-sonnet-5。
# CLAUDE_MODEL=claude-sonnet-5

# Claude Agent SDK の応答待ちタイムアウト（ミリ秒）。未設定なら180000。
# CLAUDE_TIMEOUT_MS=180000

# Claude が使えない時のフォールバック先。カンマ区切りで複数指定可（自動ローテーション）。
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 他の人にも使わせる場合（共有・デプロイ）
# ---------------------------------------------------------------------------
# Console で発行した APIキーを設定する。トークン課金が発生する。
# ANTHROPIC_API_KEY=
#
# Messages API を直接叩く実装に切り替えたい場合のみ指定（Agent SDK を経由しない）。
# AI_PROVIDER=anthropic

PORT=3000
